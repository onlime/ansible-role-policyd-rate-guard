{#- Values are double-quoted (python-dotenv): backslash and double quote escaped -#}
{%- macro q(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro -%}
# {{ ansible_managed }}
# PolicydRateGuard configuration, see https://github.com/onlime/policyd-rate-guard#configuration-%EF%B8%8F

## Database
{% if policyd_mysql_unix_socket %}
DB_UNIX_SOCKET={{ q(policyd_mysql_unix_socket) }}
{% endif %}
DB_USER={{ q(policyd_mysql_user) }}
DB_PASSWORD={{ q(policyd_mysql_pass) }}
DB_DATABASE={{ q(policyd_mysql_dbname) }}

## Rate limit
QUOTA={{ policyd_quota | int }}
{% if policyd_action_text_blocked %}
ACTION_TEXT_BLOCKED={{ q(policyd_action_text_blocked) }}
{% endif %}
FAIL_ACTION={{ policyd_fail_action }}
MESSAGE_RETENTION={{ policyd_message_retention | int }}

## Logging
LOG_LEVEL={{ policyd_log_level }}
LOG_FILE={{ q(policyd_log_file) }}
SYSLOG={{ policyd_syslog | bool }}
{% if policyd_sentry_dsn %}
SENTRY_DSN={{ q(policyd_sentry_dsn) }}
SENTRY_ENVIRONMENT={{ q(policyd_sentry_environment) }}
{% endif %}
{% if policyd_webhook_enabled %}

## Webhook
WEBHOOK_ENABLED=True
WEBHOOK_URL={{ q(policyd_webhook_url) }}
WEBHOOK_SECRET={{ q(policyd_webhook_secret) }}
{% endif %}
{% if policyd_extra_env %}

## Additional settings
{% for key, value in policyd_extra_env | dictsort %}
{{ key }}={{ q(value) }}
{% endfor %}
{% endif %}
