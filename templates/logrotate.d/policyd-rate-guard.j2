# {{ ansible_managed }}
{{ policyd_log_file }} {
	rotate {{ policyd_log_rotate | int }}
	daily
	dateext
	missingok
	notifempty
	compress
	# keep yesterday's file uncompressed: the daemon may still write a few lines to it before it reopens the log
	delaycompress
	su {{ policyd_user }} adm
	create 0640 {{ policyd_user }} adm
	# no restart needed: the daemon reopens the file after rotation
}
