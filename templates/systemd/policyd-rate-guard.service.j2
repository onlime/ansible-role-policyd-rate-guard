# {{ ansible_managed }}
[Unit]
Description=PolicydRateGuard sender rate limit policy daemon for Postfix
Documentation=https://github.com/onlime/policyd-rate-guard
# The socket is created by systemd and survives restarts: Postfix's connections queue up instead of failing
Requires={{ policyd_service_name }}.socket
After={{ policyd_service_name }}.socket network.target mysql.service mariadb.service

[Service]
Type=notify
User={{ policyd_user }}
Group={{ policyd_group }}
Environment=POLICYD_ENV_FILE={{ policyd_env_file }}
ExecStart={{ policyd_venv_path }}/bin/python -m policyd_rate_guard serve --require-socket-activation
Restart=on-failure
RestartSec=2s
WatchdogSec=30s
TimeoutStopSec=20s
LimitNOFILE=8192
LogsDirectory={{ policyd_log_path | regex_replace('^/var/log/', '') }}
LogsDirectoryMode=0750
UMask=0027

# Hardening, see `systemd-analyze security policyd-rate-guard.service`
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
DevicePolicy=closed
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# EPERM instead of SIGSYS: a killed daemon means Postfix's default_action, i.e. no rate limit
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
